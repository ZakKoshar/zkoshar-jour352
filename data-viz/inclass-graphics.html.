<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Baltimore Heat Data | Data Visualizations</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f7f9fb; color: #182534; }
    .navbar { background: #132c43; }
    .page-header { padding: 3rem 0 1.5rem; }
    .chart-card { background: #fff; border: 1px solid #e3e9ee; border-radius: .75rem; padding: 1.5rem; margin-bottom: 2rem; }
    .chart-card iframe { display: block; width: 100%; border: 0; }
    footer { color: #586878; }
    @media (max-width: 576px) { .chart-card { padding: .75rem; } .page-header { padding-top: 2rem; } }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark"><div class="container"><a class="navbar-brand fw-bold" href="#top">Baltimore Heat Data</a></div></nav>
  <main id="top" class="container">
    <header class="page-header">
      <h1 class="display-6 fw-bold">Heat in Baltimore</h1>
      <p class="lead">Two data visualizations exploring extreme heat and its impact on Maryland.</p>
    </header>
    <section class="chart-card" aria-label="Indoor and outdoor heat index chart">
      <iframe title="Indoor and outdoor heat index during Baltimore heat wave, July 16-22, 2019" aria-label="Line chart" id="datawrapper-chart-TBCBL" src="https://datawrapper.dwcdn.net/TBCBL/1/" scrolling="no" height="520" loading="lazy" data-external="1"></iframe>
    </section>
    <section class="chart-card" aria-label="Baltimore and Maryland heat-related deaths chart">
      <iframe title="Baltimore has more than its share of heat-related deaths in Maryland" aria-label="Grouped bar chart" id="datawrapper-chart-Ly8it" src="https://datawrapper.dwcdn.net/Ly8it/1/" scrolling="no" height="680" loading="lazy" data-external="1"></iframe>
    </section>
  </main>
  <footer class="container pb-4"><small>Charts created with Datawrapper. Sources are listed beneath each chart.</small></footer>
  <script>
    window.addEventListener('message', function (event) {
      if (!event.origin.endsWith('datawrapper.dwcdn.net')) return;
      if (!event.data || !event.data['datawrapper-height']) return;
      const heights = event.data['datawrapper-height'];
      document.querySelectorAll('iframe[id^="datawrapper-chart-"]').forEach(function (frame) {
        if (frame.contentWindow === event.source) {
          Object.keys(heights).forEach(function (key) {
            if (frame.id === 'datawrapper-chart-' + key) frame.style.height = heights[key] + 'px';
          });
        }
      });
    });
  </script>
</body>
</html>
